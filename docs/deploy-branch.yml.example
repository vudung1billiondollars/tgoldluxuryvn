# MẪU — chưa kích hoạt. Chỉ dùng khi chuyển sang hosting PHP (không có Node.js): chép tệp này thành .github/workflows/deploy-branch.yml
# Build website và đẩy thư mục dist/ sang nhánh `deploy`.
# Dùng cho Hostinger gói Web/Shared hosting: hPanel → Websites → Advanced → Git → nhánh `deploy`,
# thư mục cài đặt để trống (public_html). Bật "Auto deployment" để tự cập nhật sau mỗi lần push.
# (Nếu dùng Hostinger Node.js Web App thì không cần workflow này — xem README.)
name: Build & publish deploy branch

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm ci --omit=dev
      - run: npm run build
      - name: Push dist/ to deploy branch
        run: |
          cd dist
          git init -q -b deploy
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -q -m "Deploy ${GITHUB_SHA::7}"
          git push -f "https://x-access-token:${{ secrets.GITHUB_TOKEN }}@github.com/${GITHUB_REPOSITORY}.git" deploy
