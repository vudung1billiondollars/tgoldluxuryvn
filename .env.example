# Sao chép thành .env (KHÔNG commit .env lên GitHub). Trên Hostinger: nhập ở mục Environment variables của ứng dụng Node.js.
PORT=3000

# ── Trang quản trị /admin ──
# Mật khẩu đăng nhập (tối thiểu 8 ký tự, nên ≥ 16 ký tự ngẫu nhiên)
ADMIN_PASSWORD=

# Thư mục dữ liệu do CMS quản lý: nội dung đã sửa, ảnh tải lên, lịch hẹn, lịch sử phiên bản.
# Nên đặt NGOÀI thư mục deploy để không mất khi deploy lại, ví dụ: /home/u123456789/tgold-data
DATA_DIR=storage

# ── Email báo lịch hẹn mới (Hostinger Email) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BOOKING_TO=

# (Tuỳ chọn) chuyển tiếp lịch hẹn sang Google Apps Script / Make / CRM
# BOOKING_WEBHOOK_URL=

# ── (Tuỳ chọn) Sao lưu nội dung CMS lên GitHub ──
# Fine-grained token, chỉ cấp cho repo này, quyền "Contents: Read and write"
# GITHUB_TOKEN=
# GITHUB_REPO=ten-tai-khoan/tgold-website
# GITHUB_BRANCH=main
